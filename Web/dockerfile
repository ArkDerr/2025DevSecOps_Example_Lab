# Usa 3.12 salvo que necesites 3.13 explícitamente
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Paquetes de sistema necesarios (ajusta según tus deps: psycopg2, Pillow, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Primero solo requirements para aprovechar la cache de capas
COPY requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

# Copia el resto del proyecto
COPY . .

# Crea usuario no root y ajusta permisos mínimos
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

# No “hornees” ALLOWED_HOSTS aquí. Lee variables en settings vía os.environ.
# Por ejemplo, en settings.py:
# ALLOWED_HOSTS = os.getenv("DJANGO_ALLOWED_HOSTS", "").split(",") if os.getenv("DJANGO_ALLOWED_HOSTS") else []

EXPOSE 8000

# Suele ser mejor parametrizar Gunicorn por env
# Ej: WEB_CONCURRENCY, GUNICORN_TIMEOUT, etc.
ENV WEB_CONCURRENCY=2 \
    GUNICORN_TIMEOUT=60

# ENTRYPOINT para migrar y (opcional) collectstatic antes de iniciar
# Crea un script pequeño
# (si prefieres, usa CMD directo y migra vía CI/CD)
CMD python manage.py migrate --noinput && \
    # Descomenta si usas Whitenoise o montas volumen de estáticos
    # python manage.py collectstatic --noinput && \
    gunicorn devopsdemo.wsgi:application \
      --bind 0.0.0.0:8000 \
      --workers ${WEB_CONCURRENCY} \
      --timeout ${GUNICORN_TIMEOUT}

